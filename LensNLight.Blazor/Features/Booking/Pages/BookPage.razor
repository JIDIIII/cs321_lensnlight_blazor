@namespace LensNLight.Blazor.Features.Booking.Pages
@page "/book/{Slug}"
@inject ICameraCatalogService Catalog
@inject NavigationManager Navigation
@inject BookingPreviewState PreviewState
@inject FrontendPreviewSettings PreviewSettings

@{
    var step = CurrentStep;
    var item = Catalog.GetBySlug(Slug);
}

<PageTitle>Book a camera | LENS N' LIGHT</PageTitle>

@if (item is null)
{
    <div class="customer-page">
        <SiteHeader />
        <main class="legal-layout">
            <p class="eyebrow">RESERVATION</p>
            <h1>Camera not found</h1>
            <p>Choose a camera from the current collection to start a booking.</p>
            <a class="primary-action" href="/#rental-catalog">Browse cameras</a>
        </main>
        <SiteFooter />
    </div>
}
else
{
    <div class="customer-page">
        <SiteHeader />
        <main class="flow-frame">
            <ol class="flow-steps" aria-label="Booking progress">
                <li class="@(step == "dates" ? "current" : "done")"><b>01</b><span>Dates</span></li>
                <li class="@(step == "personal" ? "current" : step == "review" ? "done" : "")"><b>02</b><span>Personal info</span></li>
                <li class="@(step == "review" ? "current" : "")"><b>03</b><span>Review</span></li>
            </ol>

            <header class="flow-heading">
                <p class="eyebrow">@(step == "dates" ? "RESERVATION" : step == "personal" ? "YOUR DETAILS" : "ALMOST THERE")</p>
                <h1>@(step == "dates" ? "Select Your Dates" : step == "personal" ? "Personal Information" : "Review & Confirm")</h1>
                <p>@(step == "dates" ? "Choose your rental dates and preferred pickup times." : step == "personal" ? "Provide the required details to complete your profile." : "Please double-check your booking information before proceeding to payment.")</p>
            </header>

            <div class="flow-grid">
                <section class="flow-form-card">
                    @if (step == "dates")
                    {
                        <h2>Rental period</h2>
                        <div class="field-grid">
                            <label>Start date<input type="date" min="@Today" @bind="StartDate" @bind:after="SyncCalendarMonth" /></label>
                            <label>End date<input type="date" min="@Today" @bind="EndDate" @bind:after="SyncCalendarMonth" /></label>
                            <label>Pickup time<select @bind="PickupTime"><option>10:00 AM</option><option>12:00 PM</option><option>2:00 PM</option></select><small class="field-hint">Default booking buffer: @PreviewSettings.BookingBuffer</small></label>
                            <label>Return time<select @bind="ReturnTime"><option>10:00 AM</option><option>12:00 PM</option><option>2:00 PM</option></select></label>
                        </div>
                        <div class="calendar-mock" aria-label="Date selection preview">
                            <div class="calendar-top"><button type="button" aria-label="Previous month" @onclick="PreviousMonth">‹</button><strong>@CalendarMonth.ToString("MMMM yyyy")</strong><button type="button" aria-label="Next month" @onclick="NextMonth">›</button></div>
                            <div class="calendar-grid">
                                @foreach (var day in new[] { "M", "T", "W", "T", "F", "S", "S" }) { <span class="dow">@day</span> }
                                @foreach (var day in CalendarCells)
                                {
                                    if (day is DateTime date)
                                    {
                                        <button type="button" class="@CalendarDayClass(date)" disabled="@(date.Date < DateTime.Today)" aria-label="Select @date.ToString("MMMM d, yyyy")" aria-pressed="@(date.Date == StartDate.Date || date.Date == EndDate.Date)" @onclick="() => SelectDate(date)">@date.Day</button>
                                    }
                                    else
                                    {
                                        <span class="calendar-empty" aria-hidden="true"></span>
                                    }
                                }
                            </div>
                            <p class="calendar-help">@(ChoosingStartDate ? "Choose a start date." : "Now choose a return date.")</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ValidationMessage)) { <p class="interaction-message error" role="alert">@ValidationMessage</p> }
                        <a class="primary-action full" href="@StepUrl("personal")" @onclick="GoToPersonal" @onclick:preventDefault>Continue to personal information <span aria-hidden="true">→</span></a>
                    }
                    else if (step == "personal")
                    {
                        <h2>Contact information</h2>
                        <div class="field-grid">
                            <label>Full name<input autocomplete="name" placeholder="Your full name" @bind="RenterName" /></label>
                            <label>Email address<input autocomplete="email" type="email" placeholder="you@example.com" @bind="Email" /></label>
                            <label>Mobile number<input autocomplete="tel" type="tel" placeholder="09XX XXX XXXX" @bind="Phone" /></label>
                            <label>Facebook profile URL<input type="url" placeholder="https://facebook.com/" @bind="FacebookUrl" /></label>
                            <label class="wide">Complete address<textarea autocomplete="street-address" placeholder="House no., street, barangay, city" @bind="Address"></textarea></label>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ValidationMessage)) { <p class="interaction-message error" role="alert">@ValidationMessage</p> }
                        <div class="flow-actions"><a class="secondary-action" href="@StepUrl("dates")" @onclick="GoToDates" @onclick:preventDefault>Back</a><a class="primary-action" href="@StepUrl("review")" @onclick="GoToReview" @onclick:preventDefault>Review booking →</a></div>
                    }
                    else
                    {
                        <h2>Booking summary</h2>
                        <dl class="review-list"><div><dt>Renter</dt><dd>@Display(RenterName, "Your name")</dd></div><div><dt>Rental dates</dt><dd>@StartDate.ToString("MMMM d, yyyy") – @EndDate.ToString("MMMM d, yyyy")</dd></div><div><dt>Pickup &amp; return</dt><dd>@PickupTime · @ReturnTime</dd></div><div><dt>Contact</dt><dd>@Display(Email, "Email") · @Display(Phone, "Mobile")</dd></div><div><dt>Facebook profile</dt><dd>@Display(FacebookUrl, "Not provided")</dd></div><div><dt>Address</dt><dd>@Display(Address, "Not provided")</dd></div></dl>
                        <label class="check-line"><input type="checkbox" @bind="TermsAccepted" /> I agree to the <a href="/terms" target="_blank" rel="noreferrer">rental terms and conditions</a>.</label>
                        @if (!string.IsNullOrWhiteSpace(ValidationMessage)) { <p class="interaction-message error" role="alert">@ValidationMessage</p> }
                        <div class="flow-actions"><a class="secondary-action" href="@StepUrl("personal")" @onclick="GoToPersonal" @onclick:preventDefault>Back</a><a class="primary-action" href="@PaymentUrl" @onclick="ProceedToPayment" @onclick:preventDefault>Continue to payment →</a></div>
                    }
                </section>

                <aside class="flow-item">
                    <img src="@(item.Images.FirstOrDefault()?.Url ?? "/images/cameras/canon-eos-r50-1.webp")" alt="@item.Name" />
                    <div><span class="eyebrow">@item.Category.ToUpperInvariant()</span><h2>@item.Name</h2><p>@foreach (var tier in item.PricingTiers) { <span>@tier.Label <strong>₱@tier.DailyRate.ToString("N0")/day</strong><br /></span> }</p><span class="availability-pill">@item.Status</span></div>
                    <h3>Included in your rental</h3>
                    <ul>@foreach (var inclusion in item.Accessories) { <li>@inclusion</li> }</ul>
                    <div class="flow-total"><span>Security deposit</span><strong>₱@item.SecurityDeposit.ToString("N0")</strong></div>
                </aside>
            </div>
        </main>
        <SiteFooter />
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private DateTime StartDate { get; set; } = DateTime.Today.AddDays(1);
    private DateTime EndDate { get; set; } = DateTime.Today.AddDays(3);
    private DateTime CalendarMonth { get; set; } = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private bool ChoosingStartDate { get; set; } = true;
    private bool TermsAccepted { get; set; }
    private string ValidationMessage { get; set; } = string.Empty;
    private string Today => DateTime.Today.ToString("yyyy-MM-dd");
    private IReadOnlyList<DateTime?> CalendarCells
    {
        get
        {
            var firstDay = new DateTime(CalendarMonth.Year, CalendarMonth.Month, 1);
            var leadingCells = ((int)firstDay.DayOfWeek + 6) % 7;
            var totalCells = (int)Math.Ceiling((leadingCells + DateTime.DaysInMonth(firstDay.Year, firstDay.Month)) / 7d) * 7;
            return Enumerable.Range(0, totalCells)
                .Select(index => index < leadingCells || index >= leadingCells + DateTime.DaysInMonth(firstDay.Year, firstDay.Month)
                    ? (DateTime?)null
                    : firstDay.AddDays(index - leadingCells))
                .ToArray();
        }
    }
    private string PickupTime { get; set; } = "10:00 AM";
    private string ReturnTime { get; set; } = "10:00 AM";
    private string RenterName { get; set; } = "";
    private string Email { get; set; } = "";
    private string Phone { get; set; } = "";
    private string FacebookUrl { get; set; } = "";
    private string Address { get; set; } = "";

    protected override void OnParametersSet()
    {
        PreviewState.BeginFor(Slug);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("start", out var start) && DateTime.TryParse(start.ToString(), out var startDate)) PreviewState.StartDate = startDate.Date;
        if (query.TryGetValue("end", out var end) && DateTime.TryParse(end.ToString(), out var endDate)) PreviewState.EndDate = endDate.Date;
        StartDate = PreviewState.StartDate;
        EndDate = PreviewState.EndDate;
        CalendarMonth = new DateTime(StartDate.Year, StartDate.Month, 1);
        PickupTime = PreviewState.PickupTime;
        ReturnTime = PreviewState.ReturnTime;
        RenterName = PreviewState.RenterName;
        Email = PreviewState.Email;
        Phone = PreviewState.Phone;
        FacebookUrl = PreviewState.FacebookUrl;
        Address = PreviewState.Address;
        TermsAccepted = PreviewState.TermsAccepted;
    }

    private string CurrentStep
    {
        get
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
            var requested = query.TryGetValue("step", out var value) ? value.ToString() : "dates";
            return requested is "personal" or "review" ? requested : "dates";
        }
    }

    private string StepUrl(string step) => $"/book/{Uri.EscapeDataString(Slug)}?step={step}&start={StartDate:yyyy-MM-dd}&end={EndDate:yyyy-MM-dd}";
    private string PaymentUrl => $"/payment/LNL-DEMO-001?item={Uri.EscapeDataString(Slug)}&days={RentalDays}&start={StartDate:yyyy-MM-dd}&end={EndDate:yyyy-MM-dd}";
    private int RentalDays => Math.Max(1, (int)(EndDate.Date - StartDate.Date).TotalDays);
    private void GoToDates() { CaptureDraft(); Navigation.NavigateTo(StepUrl("dates")); }
    private void GoToPersonal()
    {
        if (StartDate.Date < DateTime.Today || RentalDays < PreviewSettings.MinimumRentalDays)
        {
            ValidationMessage = $"Choose a start date today or later and a return date at least {PreviewSettings.MinimumRentalDays} day(s) after pickup.";
            return;
        }

        ValidationMessage = string.Empty;
        CaptureDraft();
        Navigation.NavigateTo(StepUrl("personal"));
    }
    private void GoToReview()
    {
        if (string.IsNullOrWhiteSpace(RenterName) || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Phone) || string.IsNullOrWhiteSpace(Address))
        {
            ValidationMessage = "Please complete your name, email, mobile number, and address before continuing.";
            return;
        }

        if (!System.Net.Mail.MailAddress.TryCreate(Email, out _))
        {
            ValidationMessage = "Enter a valid email address to continue.";
            return;
        }

        ValidationMessage = string.Empty;
        CaptureDraft();
        Navigation.NavigateTo(StepUrl("review"));
    }

    private void ProceedToPayment()
    {
        if (!TermsAccepted)
        {
            ValidationMessage = "Please review and accept the rental terms before proceeding.";
            return;
        }

        ValidationMessage = string.Empty;
        CaptureDraft();
        Navigation.NavigateTo(PaymentUrl);
    }

    private void CaptureDraft()
    {
        PreviewState.BeginFor(Slug);
        PreviewState.StartDate = StartDate.Date;
        PreviewState.EndDate = EndDate.Date;
        PreviewState.PickupTime = PickupTime;
        PreviewState.ReturnTime = ReturnTime;
        PreviewState.RenterName = RenterName.Trim();
        PreviewState.Email = Email.Trim();
        PreviewState.Phone = Phone.Trim();
        PreviewState.FacebookUrl = FacebookUrl.Trim();
        PreviewState.Address = Address.Trim();
        PreviewState.TermsAccepted = TermsAccepted;
    }

    private void SyncCalendarMonth() => CalendarMonth = new DateTime(StartDate.Year, StartDate.Month, 1);
    private void PreviousMonth() => CalendarMonth = CalendarMonth.AddMonths(-1);
    private void NextMonth() => CalendarMonth = CalendarMonth.AddMonths(1);

    private void SelectDate(DateTime date)
    {
        ValidationMessage = string.Empty;
        if (ChoosingStartDate)
        {
            StartDate = date.Date;
            if (EndDate.Date <= StartDate.Date)
            {
                EndDate = StartDate.AddDays(1);
            }
        }
        else if (date.Date > StartDate.Date)
        {
            EndDate = date.Date;
        }
        else
        {
            StartDate = date.Date;
            EndDate = StartDate.AddDays(1);
        }

        ChoosingStartDate = !ChoosingStartDate;
    }

    private string CalendarDayClass(DateTime date)
    {
        if (date.Date == StartDate.Date || date.Date == EndDate.Date) return "selected";
        return date.Date > StartDate.Date && date.Date < EndDate.Date ? "in-range" : string.Empty;
    }
    private static string Display(string value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
}
