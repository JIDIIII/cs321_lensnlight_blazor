@namespace LensNLight.Blazor.Features.Admin.Pages
@page "/admin/settings"

<PageTitle>Settings · Admin · LENS N' LIGHT</PageTitle>
<AdminShell Active="settings" Title="Settings" Description="Manage payment methods and system-wide rental configuration.">
    <section class="admin-panel settings-panel">
        <div class="panel-heading"><div><h2>Featured camera</h2><p>Choose the camera shown in the homepage feature.</p></div><span class="admin-eyebrow">HOMEPAGE</span></div>
        <label>Featured item<select><option>Canon EOS R50</option><option>Panasonic Lumix TZ99</option></select></label>
        <hr />
        <div class="panel-heading"><div><h2>Booking configuration</h2><p>Set default timing and customer experience options.</p></div></div>
        <div class="field-grid"><label>Default booking buffer<select><option>2 hours</option><option>4 hours</option></select></label><label>Minimum rental period<select><option>1 day</option><option>2 days</option></select></label><label>Business name<input value="LENS N' LIGHT Camera Rental" /></label><label>Customer support email<input type="email" placeholder="support@example.com" /></label></div>
        <button class="admin-button gold" type="button">Save configuration preview</button>
    </section>
    <section class="admin-panel settings-panel">
        <div class="panel-heading"><div><h2>Payment methods</h2><p>Customer payment options and payment instructions.</p></div><button class="admin-button gold" type="button">+ Add method</button></div>
        <div class="method-row"><span class="method-mark">G</span><div><strong>GCash</strong><small>0917 123 4567 · LENS N' LIGHT Camera Rental</small></div><span class="status-chip active">Active</span><button type="button">Edit</button></div>
        <div class="method-row"><span class="method-mark">B</span><div><strong>Bank transfer</strong><small>BDO · 0123 456 789</small></div><span class="status-chip active">Active</span><button type="button">Edit</button></div>
    </section>
    <section class="admin-panel settings-panel">
        <div><h2>Rental terms &amp; conditions</h2><p>Preview the terms shown during booking review.</p></div>
        <textarea rows="7">Please handle all equipment with care. Return equipment and listed accessories at the agreed date and time. A security deposit is collected for each rental and returned after inspection.</textarea>
        <button class="admin-button gold" type="button">Save terms preview</button>
    </section>
</AdminShell>
