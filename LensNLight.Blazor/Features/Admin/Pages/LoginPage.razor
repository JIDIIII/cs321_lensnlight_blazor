@namespace LensNLight.Blazor.Features.Admin.Pages
@page "/admin/login"

<PageTitle>Admin sign in · LENS N' LIGHT</PageTitle>
<main class="portal-login">
    <form class="portal-login-card" @onsubmit="ContinueToPreview" @onsubmit:preventDefault>
        <img src="/images/branding/lens-n-light-logo-front.png" alt="LENS N' LIGHT" />
        <span class="portal-kicker">ADMIN PORTAL</span>
        <h1>Sign in</h1>
        <label>Email<input type="email" autocomplete="username" placeholder="admin@example.com" required @bind="Email" /></label>
        <label>Password<input type="password" autocomplete="current-password" placeholder="Password" required @bind="Password" /></label>
        <button class="primary-action" type="submit">Continue to admin preview</button>
        <p class="payment-demo-note">Frontend preview only · Sign-in is not connected to an account.</p>
    </form>
</main>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private void ContinueToPreview() => Navigation.NavigateTo("/admin/items");
}
